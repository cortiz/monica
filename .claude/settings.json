{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(go generate:*)",
      "Bash(go mod tidy)",
      "Bash(go list:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(make test)",
      "Bash(make pr)",
      "Bash(make fmt)",
      "Bash(make build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./dist/**)",
      "Read(./monica)",
      "Read(./**/*.out)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gofmt.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
