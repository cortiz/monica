{
  // REST Client environments
  "editor.tabSize": 2,
  "rest-client.environmentVariables": {
    "$shared": {
      "version": "v1"
    },
    "local": {
      "baseUrl": "http://localhost:1",
      "host": "localhost:1",
      /* refers to other values: resolved at import */
      "apiBase": "{{baseUrl}}/{{$shared version}}",
      "user": "ada",
    },
  },
  "rest-client.defaultHeaders": {
    "User-Agent": "vscode-restclient",
    "X-Client": "rest",
  },
}
