# ${NAME} values (here EXAMPLE_TOKEN from .env) are sent for real but masked
# as **** in the report, errors and logs.

### Send a secret
# @name secret
GET {{baseUrl}}/headers
Authorization: Bearer {{apiToken}}

> {%
  test("the server got the real token", () => expect(res.json().headers.Authorization).toBe("Bearer example-token-123"));
  console.log("printed masked:", vars.get("apiToken"));
%}
